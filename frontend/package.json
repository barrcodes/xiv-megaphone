{
  "name": "xiv-megaphone",
  "desktopName": "xiv-megaphone",
  "icon": "resources/app.ico",
  "author": "barrcodes",
  "description": "A websocket text-to-speech client app for Final Fantasy XIV using Inworld AI",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/barrcodes/xiv-megaphone.git"
  },
  "main": "./build/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "biome check .",
    "preview": "electron-vite build && electron-vite preview",
    "preview:dev": "electron-vite build --mode development && electron-vite preview --mode development --skipBuild",
    "package:linux": "bun run build && electron-builder --linux AppImage --x64 --config electron-builder.linux.yml --publish never",
    "publish:linux": "bun run build && electron-builder --linux AppImage --x64 --config electron-builder.linux.yml --publish always",
    "verify:linux": "node scripts/verify-package.cjs linux",
    "verify:win": "node scripts/verify-package.cjs win",
    "verify:release": "node scripts/verify-release-assets.cjs",
    "test": "vitest run && node --test scripts/package-verification.node-test.cjs",
    "start": "node scripts/run-forge.cjs start",
    "package": "node scripts/run-forge.cjs package",
    "make": "node scripts/run-forge.cjs make",
    "build:make": "bun run build && bun run make",
    "publish": "node scripts/run-forge.cjs publish"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "i18next": "^26.4.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.5.0",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "update-electron-app": "^3.2.0",
    "usehooks-ts": "^3.1.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/asar": "^3.4.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "rebuild"
  ]
}
