#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Git supplies every ref update on stdin; inspect the entire pushed range.
run_frontend=false
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleted refs have no code to validate.
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac

    # New refs (or unavailable remote objects) conservatively check the full tree.
    if ! base=$(git rev-parse --verify "$remote_oid^{tree}" 2>/dev/null); then
        base=$(git hash-object -w -t tree --stdin </dev/null)
    fi
    if git diff --quiet --no-ext-diff --no-renames "$base" "$local_oid" -- frontend/; then
        :
    else
        status=$?
        [ "$status" -eq 1 ] || exit "$status"
        run_frontend=true
    fi
done

if [ "$run_frontend" = true ]; then
    echo "pre-push: frontend changes detected; running frontend tests"
    (cd "$repo_root/frontend" && bun run test </dev/null)
else
    echo "pre-push: no frontend changes; skipping frontend tests"
fi
