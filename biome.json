{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "root": true,

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": ["**", "!!**/build", "!!**/dist", "!!**/out"]
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true
  },

  "javascript": {
    "formatter": {
      "semicolons": "always"
    }
  }
}
