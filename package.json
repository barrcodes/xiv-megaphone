{
  "name": "xiv-megaphone-project",
  "type": "module",
  "scripts": {
    "postinstall": "cd frontend && bun install",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "mprocs",
    "smoke": "mprocs -c mprocs.smoke.yaml",
    "lint": "biome check .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "lint:migrate": "biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
